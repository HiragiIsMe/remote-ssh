{
  "name": "ssh-command-studio",
  "version": "1.0.0",
  "description": "Stateful SSH Remote Command Studio Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.sshcommandstudio.app",
    "productName": "SSH Command Studio",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "electron",
    "cmd",
    "ssh",
    "terminal",
    "shortcut",
    "dashboard"
  ],
  "author": "HiragiIsMe",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "sql.js": "^1.14.2",
    "ssh2": "^1.15.0"
  }
}
